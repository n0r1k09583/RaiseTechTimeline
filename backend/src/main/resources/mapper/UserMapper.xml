<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.raisetech.timeline.mapper.UserMapper">

  <sql id="selectUser">
    SELECT id, email, username, display_name, password_digest, created_at, updated_at
    FROM users
  </sql>

  <select id="findById" resultType="User">
    <include refid="selectUser"/>
    WHERE id = #{id}
  </select>

  <select id="findByEmail" resultType="User">
    <include refid="selectUser"/>
    WHERE email = #{email}
  </select>

  <select id="findByUsername" resultType="User">
    <include refid="selectUser"/>
    WHERE username = #{username}
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO users (email, username, display_name, password_digest)
    VALUES (#{email}, #{username}, #{displayName}, #{passwordDigest})
  </insert>

  <select id="count" resultType="int">
    SELECT COUNT(*) FROM users
  </select>
</mapper>
